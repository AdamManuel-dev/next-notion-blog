# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/
/.generated/

# generated runtime artifacts (TypeScript sources live in scripts/ and tools/)
/public/noflash.js
/public/scripts/hotjar.js
/tools/mdx-editor/dist/

# generated LLM-readable content
/public/*.md
/public/llms.txt

# production
/build
*.tsbuildinfo

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env.local
.env.build
.env.development.local
.env.test.local
.env.production.local

# vercel
.vercel
.env*
