{
  "name": "nextjs-notion-starter-kit",
  "version": "0.1.0",
  "private": true,
  "description": "The perfect starter kit for building beautiful websites with Next.js and Notion.",
  "author": "Travis Fischer <travis@transitivebullsh.it>",
  "repository": "transitive-bullshit/nextjs-notion-starter-kit",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "deploy": "vercel --prod",
    "deps": "run-s deps:*",
    "deps:update": "npm install notion-client@latest notion-types@latest notion-utils@latest react-notion-x@latest",
    "analyze": "cross-env ANALYZE=true next build",
    "analyze:server": "cross-env BUNDLE_ANALYZE=server next build",
    "analyze:browser": "cross-env BUNDLE_ANALYZE=browser next build",
    "test": "run-s test:*",
    "test:lint": "eslint .",
    "test:prettier": "prettier '**/*.{js,jsx,ts,tsx}' --check",
    "posttest": "run-s build",
    "test:types": "next typegen && tsc --noEmit",
    "test:unit": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "@google-cloud/firestore": "^4.10.1",
    "classnames": "^2.3.1",
    "date-fns": "^2.25.0",
    "fathom-client": "^3.0.0",
    "got": "^11.8.2",
    "isomorphic-unfetch": "^3.1.0",
    "katex": "^0.18.4",
    "lqip-modern": "^2.2.1",
    "next": "^15.5.27",
    "node-fetch": "^2.6.1",
    "notion-client": "8.0.8",
    "notion-types": "8.0.8",
    "notion-utils": "8.0.8",
    "p-map": "^4.0.0",
    "prismjs": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^4.3.1",
    "react-notion-x": "8.0.8",
    "react-tweet": "^3.2.2",
    "react-use": "^17.6.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.5.27",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "cross-env": "^7.0.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-config-standard-react": "^13.0.0",
    "eslint-plugin-import": "^2.25.2",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-node": "^11.0.0",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-promise": "^6.6.0",
    "eslint-plugin-react": "^7.26.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.4.1",
    "typescript": "^5.9.0"
  },
  "packageManager": "npm@11.6.2"
}
