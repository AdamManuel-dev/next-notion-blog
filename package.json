{
  "name": "next-notion-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Adam Manuel's statically exported Next.js blog with MDX content.",
  "author": "Adam Manuel",
  "repository": "AdamManuel-dev/next-notion-blog",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "npm run runtime:build",
    "runtime:build": "tsx scripts/build-runtime.ts",
    "predev": "npm run runtime:build",
    "dev": "tsx scripts/dev.ts",
    "content:generate-revision": "tsx scripts/generate-content-revision.ts",
    "content:format": "tsx scripts/format-content.ts --write",
    "content:format:check": "tsx scripts/format-content.ts --check",
    "content:preview": "tsx scripts/preview-content.ts",
    "content:check-links": "tsx scripts/check-external-links.ts",
    "content:package-editor": "npm run runtime:build && tsx scripts/package-mdx-editor.ts",
    "content:install-editor": "npm run runtime:build && tsx scripts/package-mdx-editor.ts --install",
    "prebuild": "npm run runtime:build && npm run content:generate-revision && tsx scripts/generate-static-metadata.ts",
    "build": "next build",
    "start": "tsx scripts/serve-static.ts",
    "deploy": "vercel --prod",
    "analyze": "cross-env ANALYZE=true next build",
    "pretest": "npm run runtime:build",
    "test": "run-s test:*",
    "test:lint": "eslint --ext .ts,.tsx components lib pages scripts tests tools/mdx-editor next.config.ts site.config.ts",
    "test:prettier": "prettier '**/*.{js,jsx,ts,tsx,mjs,cjs,css,json,yml,yaml}' --check",
    "posttest": "run-s build",
    "test:types": "npm run content:generate-revision && next typegen && tsc --noEmit",
    "pretest:unit": "npm run runtime:build",
    "test:unit": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "fathom-client": "^3.0.0",
    "next": "^15.5.28",
    "prismjs": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^4.3.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-stringify": "^11.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.5.27",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.0.0",
    "@types/prettier": "^2.7.3",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/unist": "^3.0.3",
    "@types/vscode": "1.90.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "cheerio": "^1.2.0",
    "cross-env": "^7.0.2",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-config-standard-react": "^13.0.0",
    "eslint-plugin-import": "^2.25.2",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-promise": "^6.6.0",
    "eslint-plugin-react": "^7.26.1",
    "mdast-util-directive": "^3.2.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-mdx-jsx": "^3.2.1",
    "mdast-util-to-hast": "^13.2.2",
    "micromark-util-types": "^2.0.3",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.4.1",
    "remark-frontmatter": "^5.0.0",
    "remark-parse": "^11.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "unified": "^11.0.5",
    "vfile": "^6.0.3"
  },
  "packageManager": "npm@11.6.2"
}
