# ------------------------------------------------------------------------------
# This is an example .env file.
#
# Every value here is optional: the site builds and runs without any of them.
# ------------------------------------------------------------------------------

# Optional: Fathom analytics site id. Only loaded in production builds.
#NEXT_PUBLIC_FATHOM_ID=

# Optional: JSON blob that overrides any value in site.config.js, e.g.
# {"name":"Staging Blog","domain":"staging.example.com"}
#NEXT_PUBLIC_SITE_CONFIG=

# Optional: port used by `npm start` when serving the static export (default 3000).
#PORT=
