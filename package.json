{
  "name": "next-notion-blog",
  "version": "0.1.0",
  "private": true,
  "description": "Adam Manuel's statically exported Next.js blog with MDX content.",
  "author": "Adam Manuel",
  "repository": "AdamManuel-dev/next-notion-blog",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/generate-static-metadata.mjs",
    "build": "next build",
    "start": "node scripts/serve-static.mjs",
    "content:verify-migration": "node --experimental-strip-types --test tests/migration/*.test.mjs",
    "deploy": "vercel --prod",
    "analyze": "cross-env ANALYZE=true next build",
    "test": "run-s test:*",
    "test:lint": "eslint --ext .ts,.tsx,.mjs,.cjs components lib pages scripts tests",
    "test:prettier": "prettier '**/*.{js,jsx,ts,tsx,mjs,cjs,css,json,yml,yaml}' --check",
    "posttest": "run-s build",
    "test:types": "next typegen && tsc --noEmit",
    "test:unit": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "fathom-client": "^3.0.0",
    "next": "^15.5.28",
    "prismjs": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^4.3.1",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.5.27",
    "@types/node": "^22.0.0",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "cheerio": "^1.2.0",
    "cross-env": "^7.0.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-config-standard-react": "^13.0.0",
    "eslint-plugin-import": "^2.25.2",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-promise": "^6.6.0",
    "eslint-plugin-react": "^7.26.1",
    "npm-run-all": "^4.1.5",
    "playwright": "^1.64.1",
    "prettier": "^2.4.1",
    "typescript": "^5.9.0"
  },
  "packageManager": "npm@11.6.2"
}
